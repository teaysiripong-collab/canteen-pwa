# --- Database (System of Record) ---
# Local development example:
#   postgres://canteen:canteen@127.0.0.1:5432/canteen_dev
# Supabase (session pooler, port 5432 / transaction pooler, port 6543):
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets export (optional, one-way ERP -> Sheets) ---
# All three must be set before the "Sheets" button appears on /reports; CSV download works
# without them. Nothing is ever read back from the spreadsheet — PostgreSQL stays the only
# source of truth, so a spreadsheet anyone can edit cannot write into the system.
#
# Setup: create a service account, give it a JSON key, then share the target spreadsheet with
# the service account's email as an Editor. Paste the key's `private_key` value below with its
# newlines escaped as \n (one line), exactly as it appears in the JSON file.
# Never commit a real key — .env.local is gitignored, this file holds names only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# --- AI Copilot enhancement (optional and may incur provider charges) ---
# Without this key the assistant uses the free built-in Thai question router. Both modes
# only read data the signed-in user already has permission to see.
ANTHROPIC_API_KEY=

# --- First-time production bootstrap (`npm run db:bootstrap` only) ---
# ADMIN_EMAIL must match the Supabase Auth user who will sign in first — the system links
# an authenticated session to a `users` row by email. ADMIN_NAME and ORG_NAME are optional.
ADMIN_EMAIL=
ADMIN_NAME=
ORG_NAME=

# --- Local development only ---
# Enables the email-only development sign-in when Supabase Auth is not configured.
# Ignored (hard-disabled) when NODE_ENV=production.
ALLOW_DEV_AUTH=false
